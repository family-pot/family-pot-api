# Copy to .env.local for local development. Replace placeholders; never commit
# real credentials or secrets.
PORT=4000
NODE_ENV=development

# Local Postgres. The username and password are placeholders for development.
DATABASE_URL=postgres://family_pot:family_pot@localhost:5432/family_pot
DATABASE_URL_TEST=postgres://family_pot:family_pot@localhost:5432/family_pot_test
DATABASE_SSL=false

# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000

# Use a long random value in real environments; at least 32 characters.
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# strict (recommended, same-site proxy), lax, or none (cross-site API; needs HTTPS).
REFRESH_COOKIE_SAME_SITE=strict

# Rate limits per client IP. The auth limit applies to register, login and
# refresh; the global limit applies to everything. Responses over a limit are 429.
RATE_LIMIT_GLOBAL_LIMIT=100
RATE_LIMIT_GLOBAL_TTL_SECONDS=60
RATE_LIMIT_AUTH_LIMIT=10
RATE_LIMIT_AUTH_TTL_SECONDS=60
# Maximum request body size, such as 100kb or 1mb.
REQUEST_BODY_LIMIT=100kb
# Reverse proxies in front of the API (Render sets X-Forwarded-For). Use 1 behind
# one proxy, otherwise all clients share the proxy's IP and its rate limit.
TRUST_PROXY=0

# Keep false except for disposable local databases.
ALLOW_REMOTE_DB_RESET=false
